{
  "name": "retext-lexrank",
  "version": "2.0.0",
  "description": "Lexrank algorithm for retextjs",
  "license": "MIT",
  "keywords": [
    "unist",
    "retext",
    "nlp",
    "lexrank",
    "salience"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gorango/retext-lexrank.git"
  },
  "bugs": "https://github.com/gorango/retext-lexrank/issues",
  "sideEffects": false,
  "type": "module",
  "exports": "./index.js",
  "types": "index.d.ts",
  "files": [
    "lib/",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "vitest run --dir lib",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --dir lib --coverage",
    "build": "tsc --build --clean && tsc --build",
    "release": "npx standard-version -i changelog.md"
  },
  "dependencies": {
    "nlcst-to-string": "^4.0.0",
    "stemmer": "^2.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/nlcst": "^2.0.3",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.3",
    "retext-keywords": "^8.0.2",
    "retext-latin": "^4.0.0",
    "retext-pos": "^5.0.0",
    "to-vfile": "^8.0.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-select": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
